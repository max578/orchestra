    "steps": [
      {
        "id": "pc_L1",
        "label": "check: ASReml on simulated yields",
        "member": "asreml",
        "does": "Fits the ASReml lens to a copy whose yields are APSIM simulations plus trial noise, and checks it recovers the simulated effect."
      },
      {
        "id": "pc_L2",
        "label": "check: flexyBayes on simulated yields",
        "member": "flexyBayes",
        "does": "Fits the flexyBayes lens to the same simulated copy and checks it recovers the simulated effect."
      },
      {
        "id": "pc_L3",
        "label": "check: proxymix on simulated yields",
        "member": "proxymix",
        "does": "Fits the proxymix lens to the same simulated copy and checks it recovers the simulated effect."
      },
      {
        "id": "A0",
        "label": "crop model, uncalibrated",
        "member": "apsimx",
        "does": "Takes the Early-minus-Main difference from APSIM runs with default settings, per pair."
      },
      {
        "id": "A1",
        "label": "crop model, calibrated",
        "member": "PESTO",
        "does": "Takes the Early-minus-Main difference from APSIM calibrated to each pair with PESTO."
      },
      {
        "id": "gate_L1",
        "label": "gate for ASReml",
        "member": "conductoR",
        "does": "Withholds the ASReml lens if its positive control failed."
      },
      {
        "id": "gate_L2",
        "label": "gate for flexyBayes",
        "member": "conductoR",
        "does": "Withholds the flexyBayes lens if its positive control failed."
      },
      {
        "id": "gate_L3",
        "label": "gate for proxymix",
        "member": "conductoR",
        "does": "Withholds the proxymix lens if its positive control failed."
      },
      {
        "id": "L1",
        "label": "mixed model (ASReml)",
        "member": "asreml",
        "does": "REML mixed model of the Early-minus-Main difference, with site, year, variety and pair effects and trial weights."
      },
      {
        "id": "L2",
        "label": "Bayesian model (flexyBayes)",
        "member": "flexyBayes",
        "does": "Bayesian version of the same model (INLA), giving posterior draws of the average effect and of a new paddock and season."
      },
      {
        "id": "L3",
        "label": "no-normality model (proxymix)",
        "member": "proxymix",
        "does": "Gaussian-mixture uplift model of Early and Main yields with pre-sowing covariates; interval from a bootstrap over pairs."
      },
      {
        "id": "quorum",
        "label": "spread check between methods",
        "member": "quorum",
        "does": "Judges whether the three lenses agree on the average effect."
      },
      {
        "id": "compare",
        "label": "trials against crop model",
        "member": "conductoR",
        "does": "Sets the field estimates beside the two crop-model arms."
      },
      {
        "id": "money",
        "label": "value per hectare and decision",
        "member": "decideR",
        "does": "Turns the flexyBayes posterior into dollars per hectare at the ABARES wheat price and chooses a sowing window."
      },
      {
        "id": "agree_loc",
        "label": "agreement on effect size",
        "member": "conductoR",
        "does": "Checks that the three lenses' average effects lie within 0.10 t/ha of each other."
      }
    ],
