      },
      {
        "id": "slope_iid",
        "member": "stats",
        "does": "sensitivity: slope under independent errors"
      },
      {
        "id": "slope_pm",
        "member": "proxymix",
        "does": "proxymix: Gaussian-mixture errors after decorrelation, slope by maximum likelihood, parametric bootstrap interval"
      },
      {
        "id": "resid_space",
        "member": "kernR",
        "does": "anisotropy likelihood ratio, HSIC and Moran's I on decorrelated residuals; branch: slope under an anisotropic GP"
      },
      {
        "id": "influence",
        "member": "conductoR",
        "does": "most outlying sample (Bonferroni), leave-one-out slope changes, leave-one-flooding-class-out; branch: slope without the outlying sample"
