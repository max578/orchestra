---
import Base from "../../layouts/Base.astro";
import { href } from "../../data/site";
---
<Base title="Study" description="The study on the poster: does wheat sown earlier yield more? Same-paddock NVT pairs, NSW and Queensland, 2008 to 2017." path="/examples">
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">One study through the orchestra</p>
      <h1>Study</h1>
      <p class="prose lead mt-2">One grain-production question, taken from open data to a decision a grower can act on,
        with the R code to run it again.</p>
    </div>
    <div class="grid grid-2">
      <a class="card ex-card" href={href("/examples/sowing-time")}>
        <p class="kicker">Open NVT results · NSW and Queensland, 2008 to 2017</p>
        <h2 class="ex-card-h">Does wheat sown earlier yield more?</h2>
        <p class="muted mt-2">Early sowing gained 0.22 t/ha (0.06 to 0.39), worth $58/ha at $261/t. The average gain is
          positive with 98% probability.</p>
      </a>
    </div>
  </section>
</Base>
