---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { href } from "../data/site";
import { delegates, concordCharter } from "../data/delegates";
import { necessityById } from "../data/necessity";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Concord of Long Fields",
  description:
    "A narrative device: each released member of the Crop Analytics Orchestra, personified as the foremost specialist of an invented far-away people whose mathematics is the member's method.",
};
---
<Base title="Delegates"
      description="The Concord of Long Fields — the orchestra's teaching fiction: one invented people per released member, whose mathematics is the member's method."
      path="/delegates" jsonLd={jsonLd}>
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">A narrative device</p>
      <h1>The Concord of Long Fields</h1>
      <p class="lead mt-3">“{concordCharter}”</p>
      <p class="prose muted mt-3">Far from here, a compact of peoples formed around that
        one sentence. Each people walked its own road to a mathematical frontier, and each
        sends its foremost specialist as a delegate. Every delegate knows the others'
        knowledge; none acts on an unchecked fact. The delegates are the released members
        of the orchestra — <strong>this page is fiction in service of teaching; the
        science lives on the member pages and in the studies.</strong></p>
    </div>

    <div class="grid grid-2">
      {delegates.map((d) => {
        const tier = necessityById.get(d.id)?.tier;
        return (
          <article class="card delegate">
            <div class="delegate-row">
              <Avatar motif={d.motif} size={120}
                label={`${d.name}, delegate of ${d.people.split(",")[0]}`} />
              <div>
                <h3>{d.name}</h3>
                <p class="small muted">{d.title}</p>
                <div class="meta mt-1">
                  <a class="badge" href={href(`/members/${d.id}`)}>{d.id} ↗</a>
                  {tier && <span class="badge">{tier}</span>}
                </div>
              </div>
            </div>
            <p class="prose mt-2 small">{d.people}</p>
            <p class="prose mt-2 small"><strong>Frontier:</strong> {d.frontier}</p>
            <p class="creed mt-2">“{d.creed}”</p>
          </article>
        );
      })}
    </div>

    <p class="prose muted mt-4">Peoples, names and worlds are invented and reference no
      culture of this one; delegates are they/them throughout. Two members of the wider
      constellation are parked from the release and sit outside the Concord at this release.</p>
  </section>
</Base>

<style>
  .delegate-row { display: flex; gap: 1.2rem; align-items: center; }
  .delegate-row .avatar { flex: none; color: var(--surface-ink); }
  .creed { font-family: var(--display); font-size: var(--step-1); }
</style>
