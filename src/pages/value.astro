---
// Value for growers: three scenarios of what translating this way of working into
// grain production could be worth. Every number is read from src/data/value/
// (copied from ORCHESTRA_dev/website/data/value/, scenario model scenarios.R, 2026-10-22).
import Base from "../layouts/Base.astro";
import { href } from "../data/site";
import V from "../data/value/scenarios.json";
import curvesCsv from "../data/value/adoption_curves.csv?raw";
import sourcesCsv from "../data/value/sources.csv?raw";

function parseCsv(text: string): Record<string, string>[] {
  const rows: string[][] = [];
  let row: string[] = [], cell = "", q = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (q) { if (c === '"' && text[i + 1] === '"') { cell += '"'; i++; } else if (c === '"') q = false; else cell += c; }
    else if (c === '"') q = true;
    else if (c === ",") { row.push(cell); cell = ""; }
    else if (c === "\n") { row.push(cell); rows.push(row); row = []; cell = ""; }
    else if (c !== "\r") cell += c;
  }
  if (cell || row.length) { row.push(cell); rows.push(row); }
  const [head, ...body] = rows;
  return body.filter((r) => r.length === head.length).map((r) => Object.fromEntries(head.map((h, i) => [h, r[i]])));
}

const S = V.scenarios as any[];
if (S.length !== 3) throw new Error("scenarios.json: expected three scenarios");
const curves = parseCsv(curvesCsv);
// only sources read at the source (or the study's own result) are listed
const sources = parseCsv(sourcesCsv).filter((s) => s.status.startsWith("verified") || s.status === "given");
const srcIds = new Set(sources.map((s) => s.id));
for (const sc of S) for (const inp of sc.inputs) for (const id of String(inp.source).split(/;\s*/)) {
  if (!srcIds.has(id)) throw new Error(`${sc.id}: input "${inp.name}" cites ${id}, which is not a verified source`);
}

const money = (x: number) => x >= 1e9 ? `$${(x / 1e9).toFixed(2)} billion` : x >= 1e6 ? `$${(x / 1e6).toFixed(x >= 1e8 ? 0 : 1)} million` : `$${Math.round(x).toLocaleString("en-AU")}`;
const n0 = (x: number) => Math.round(x).toLocaleString("en-AU");
const pct = (x: number) => `${Math.round(x * 100)}%`;
const label = (s: any) => s.name.split(":")[0];
const sub = (s: any) => s.name.split(":").slice(1).join(":").trim();
const inp = (s: any, name: string) => s.inputs.find((i: any) => i.name.startsWith(name));
const C = V.context as any;

// adoption curves: central benefit by year, one line per scenario, drawn at build time
const COLS: Record<string, string> = { minimum: "#009E73", realistic: "#0072B2", optimistic: "#D55E00" };
const W = 720, H = 300, L = 64, R = 120, T = 16, B = 40;
const years = [...new Set(curves.map((r) => Number(r.year)))].sort((a, b) => a - b);
const maxY = Math.max(...curves.map((r) => Number(r.benefit_central)));
const top = Math.ceil(maxY / 2e7) * 2e7;
const xs = (y: number) => L + ((y - years[0]) / (years.at(-1)! - years[0])) * (W - L - R);
const ys = (v: number) => T + (1 - v / top) * (H - T - B);
const lines = S.map((s) => {
  const pts = curves.filter((r) => r.id === s.id).map((r) => [xs(Number(r.year)), ys(Number(r.benefit_central))]);
  return { id: s.id, name: label(s), d: pts.map((p, i) => `${i ? "L" : "M"}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" "), end: pts.at(-1)! };
});
const yTicks = Array.from({ length: top / 2e7 + 1 }, (_, i) => i * 2e7);
const xTicks = years.filter((y) => y === 1 || y % 5 === 0);

const shifts = [
  { h: "Translation to grain analytics", p: "A question a grower or adviser asks, such as when to sow or how much nitrogen to apply, is answered by a plan that joins data, crop simulation, statistics and the decision in one run. The same packages serve the next question, so each new analysis costs less than the last." },
  { h: "A change in how analysis is done", p: "Each analysis is written as a plan, tested on data where the answer is known, sealed, and only then run. A step that cannot support an answer declines, and says why, rather than returning a number. Results carry their uncertainty and their source to the next step and to the decision." },
  { h: "Confidential data, analysed where they are held", p: C.data_confidentiality },
];
const ageOf = (s: any) => `${n0(s.area_at_peak_ha)} ha (${pct(s.adoption_ceiling)} of ${n0(inp(s, "Wheat area").value)} ha) after ${s.years_to_peak} years`;
---
<Base title="Value for growers" description="What translating sealed, checked crop analytics into grain production could be worth to growers: three scenarios in Australian dollars, from one rule in one region to worldwide uptake, with every input sourced." path="/value">
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">Estimate · {V.as_of}</p>
      <h1>Value for growers</h1>
      <p class="prose lead mt-2">What this way of doing crop analytics could be worth to growers, in three scenarios. Each
        starts from one released result, the sowing-time study, and asks how far it could travel. These are gross
        benefits to growers before any costs, not money earned.</p>
    </div>

    <div class="grid grid-3">
      {S.map((s) => (
        <article class="card">
          <p class="kicker">{label(s)}</p>
          <h3>{sub(s)}</h3>
          <p class="result-n">{money(s.annual_benefit_aud.central)} <span class="small muted">a year</span></p>
          <p class="small muted mt-1">{money(s.annual_benefit_aud.low)} to {money(s.annual_benefit_aud.high)} a year once uptake peaks.
            Present value over 30 years: {money(s.pv30_aud.central)} ({money(s.pv30_aud.low)} to {money(s.pv30_aud.high)}).</p>
          <p class="small mt-2">{s.description}</p>
        </article>
      ))}
    </div>
    <p class="prose small muted mt-2">Ranges carry the study's 90% interval for the gain per hectare. Present values are
      discounted at {pct(inp(S[0], "Discount rate").value)} a year, the rate used in Australian rural research impact
      assessments. Wheat is valued at $261 a tonne, the ABARES gross unit value over the study seasons.</p>

    <h2 class="mt-4">Where the value comes from</h2>
    <div class="grid grid-3 mt-1">
      {shifts.map((x) => (<div class="card"><h3>{x.h}</h3><p class="muted mt-2">{x.p}</p></div>))}
    </div>

    <h2 class="mt-4">The result the scenarios start from</h2>
    <figure class="ex-fig mt-1">
      <img src={href("/figures/value/fig_C2_result.png")} width="2070" height="465" loading="lazy"
        alt="Left: the gain from sowing wheat early rather than in the main window, same variety, same paddock and season, estimated four ways, for all pairs and for north and south of 31.5 degrees S; all estimates are above zero overall. Right: the gain in dollars per hectare, narrow for the average and wide for a new paddock and season." />
      <figcaption class="small muted mt-1">On the same paddock and in the same season, the same variety yielded 0.22 t/ha
        more when sown in the early window (90% interval 0.06 to 0.39): $58 a hectare ($15 to $103) at $261 a tonne.
        North of 31.5° S the gain is 0.12 t/ha, with an interval that includes zero; south of it, 0.31 t/ha. On a new
        paddock and season the chance of a gain is 65%. Bars are 90% intervals; shaded curves are flexyBayes posteriors.
        From the orchestra poster. The same question, run through the masked-copy loop, is
        {" "}<a href={href("/examples/sowing-time")}>example E1</a>.</figcaption>
    </figure>

    <h2 class="mt-4">Uptake over time</h2>
    <p class="prose">Central yearly benefit as uptake grows to its ceiling and then holds.</p>
    <figure class="mt-1 value-chart">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Central yearly benefit by year for the three scenarios.">
        {yTicks.map((t) => (<g><line x1={L} x2={W - R} y1={ys(t)} y2={ys(t)} class="vc-grid" /><text x={L - 8} y={ys(t) + 4} text-anchor="end" class="vc-tick">{t ? `$${t / 1e6}M` : "0"}</text></g>))}
        {xTicks.map((y) => (<text x={xs(y)} y={H - B + 18} text-anchor="middle" class="vc-tick">{y}</text>))}
        <text x={(L + W - R) / 2} y={H - 4} text-anchor="middle" class="vc-tick">Year</text>
        {lines.map((l) => (<g><path d={l.d} fill="none" stroke={COLS[l.id]} stroke-width="3" stroke-linejoin="round" /><text x={l.end[0] + 8} y={l.end[1] + 4} class="vc-lab" fill={COLS[l.id]}>{l.name}</text></g>))}
      </svg>
    </figure>

    <h2 class="mt-4">The scenarios in full</h2>
    <section class="table-scroll mt-1" tabindex="0" aria-label="Scenario inputs and results"><table class="num t-wide">
      <thead><tr><th scope="col"></th>{S.map((s) => <th scope="col">{label(s)}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Area reached</th>{S.map((s) => <td>{ageOf(s)}</td>)}</tr>
        <tr><th scope="row">Gain per hectare (t/ha)</th>{S.map((s) => { const g = inp(s, "Gain per").value.map((x: number) => (x < 0.05 ? x.toFixed(3) : String(x))); return <td>{g[1]} ({g[0]} to {g[2]})</td>; })}</tr>
        <tr><th scope="row">Value per hectare</th>{S.map((s) => <td>${s.id === "optimistic" ? Number(inp(s, "Value per").value[1]).toFixed(2) : inp(s, "Value per").value[1]}</td>)}</tr>
        <tr><th scope="row">Extra grain at peak (t a year)</th>{S.map((s) => <td>{n0(s.extra_tonnes_per_year_at_peak)}</td>)}</tr>
        <tr><th scope="row">Yearly benefit at peak</th>{S.map((s) => <td>{money(s.annual_benefit_aud.central)}</td>)}</tr>
        <tr><th scope="row">Present value, 10 years</th>{S.map((s) => <td>{money(s.pv10_aud.central)}</td>)}</tr>
        <tr class="total"><th scope="row">Present value, 30 years</th>{S.map((s) => <td>{money(s.pv30_aud.central)}</td>)}</tr>
        <tr><th scope="row">Same, at 7% a year</th>{S.map((s) => <td>{money(s.pv30_central_at_7pct_aud)}</td>)}</tr>
      </tbody>
    </table></section>
    <p class="prose small muted mt-2">For scale: Australian wheat is forecast at {money(C.gross_value_wheat_2026_27_aud_m * 1e6)} in
      2026–27, and grains, oilseeds and pulses at {money(C.gross_value_grains_oilseeds_pulses_2026_27_aud_m * 1e6)}. GRDC invests
      about ${C.grdc_rde_investment_aud_m_per_year} million a year in research, with a median benefit-cost ratio of
      {" "}{C.grdc_ex_post_median_bcr} across its evaluated projects.</p>

    <h2 class="mt-4">What these numbers are not</h2>
    <ul class="prose">{(V.what_these_numbers_are_not as string[]).map((w) => <li>{w}</li>)}</ul>
    {S.map((s) => (
      <details class="mt-1"><summary><strong>{label(s)}</strong>: assumptions for this scenario</summary>
        <ul class="prose small">{(s.caveats as string[]).filter((c) => !(V.what_these_numbers_are_not as string[]).includes(c)).map((c) => <li>{c}</li>)}</ul>
      </details>
    ))}

    <h2 class="mt-4">Sources</h2>
    <ul class="prose refs">{sources.map((s) => (
      <li>{s.citation} {s.url && <a href={s.url}>{s.url}</a>}</li>))}</ul>

    <p class="cta-row"><a class="btn btn-ghost" href={href("/cost")}>What it would cost to build</a>
      <a class="btn btn-ghost" href={href("/")}>Home</a></p>
  </section>
</Base>

<style>
  .value-chart svg { width: 100%; max-width: 46rem; height: auto; display: block; }
  .vc-grid { stroke: var(--edge); stroke-width: 1; }
  .vc-tick { fill: var(--muted); font-size: 12px; font-family: var(--mono); }
  .vc-lab { font-size: 13px; font-weight: 700; font-family: var(--sans); }
</style>
