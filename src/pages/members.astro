---
import Base from "../layouts/Base.astro";
import { tiers, dataHub, installBlock, type Member } from "../data/members";
import OrchestraMap from "../components/OrchestraMap.astro";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "ORCHESTRA members",
  hasPart: tiers.member.map((m) => ({ "@type": "SoftwareSourceCode", name: m.id, description: m.role })),
};
const label = { public: "public", gated: "under development", private: "private", disabled: "private · disabled", unspecified: "not public", candidate: "candidate", external: "external" };
const sectionsOf = [
  { tier: "member" as const, id: "full", title: "Full members",
    intro: `The ${tiers.member.length} packages of the orchestra. Open one to see what it does, when it gives no result, the work still to do, its nearest alternatives and its advantages. An advantage marked tested has a recorded result behind it. One marked claimed has no recorded result yet.` },
  { tier: "external" as const, id: "invited", title: "Invited members",
    intro: "Packages by other authors that the orchestra uses. Listing them implies no affiliation." },
];
const searchText = (m: Member) =>
  [m.id, m.role, m.method, m.guard, m.work, ...(m.alternatives ?? []), ...(m.advantages ?? []).map((a) => a.text)]
    .filter(Boolean).join(" ").toLowerCase();
---
<Base title="Members" description={`The ${tiers.member.length} full members of the orchestra, its data catalogue DataHub, and the ${tiers.external.length} packages by other authors it uses.`} path="/members" jsonLd={jsonLd}>
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">The catalogue</p>
      <h1>Members</h1>
      <p class="prose muted mt-2">The map shows how the packages connect. The lists under it give each
        package's details, with the install line wherever the package is public.</p>
    </div>

    <OrchestraMap />

    <div class="card mt-3" id="datahub">
      <p class="kicker">{dataHub.role}</p>
      <h2 class="mt-1">{dataHub.id}</h2>
      <p class="prose mt-2">{dataHub.method} It holds {dataHub.nDatasets} open datasets,{" "}
        {dataHub.nAustralia} of them Australian. It sits on the map in the data section, beside terroir and
        masque. It is a catalogue, not an R package.</p>
    </div>

    <div class="cat-tools" data-cat-tools hidden>
      <input class="filter" type="search" placeholder="Filter by name or by what a package does…"
             aria-label="Filter the catalogue" data-filter-input />
      <span class="filter-count" data-filter-count aria-live="polite"></span>
      <button class="btn btn-ghost" type="button" data-expand-all>Expand all</button>
      <button class="btn btn-ghost" type="button" data-collapse-all>Collapse all</button>
    </div>

    {sectionsOf.map((sec) => (
      <div data-tier id={sec.id}>
        <h2 class="tier-title">{sec.title}</h2>
        <p class="prose muted tier-intro">{sec.intro}</p>
        <div>
          {tiers[sec.tier].map((m) => (
            <details class="acc" id={`pkg-${m.id.replace(/[^A-Za-z0-9_-]/g, "-")}`} data-acc data-text={searchText(m)}>
              <summary>
                <span class="acc-chev" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3l5 5-5 5" /></svg>
                </span>
                <span><span class="acc-id">{m.id}</span>
                  <span class="acc-role"> — {m.role}</span></span>
                <span class="acc-badges">
                  <span class={`badge ${m.visibility}`}>{sec.tier === "external" ? "invited" : label[m.visibility]}</span>
                </span>
              </summary>
              <div class="acc-inner">
                <dl class="facts">
                  <dt>What it does</dt>
                  <dd>{m.method}</dd>
                  {m.guard && <><dt>When it gives no result</dt><dd>{m.guard}</dd></>}
                  {m.work && <><dt>Work still to do</dt><dd>{m.work}</dd></>}
                  {m.alternatives && m.alternatives.length > 0 &&
                    <><dt>Nearest alternatives</dt><dd>{m.alternatives.join(", ")}</dd></>}
                  {m.advantages && m.advantages.length > 0 && <>
                    <dt>Advantages</dt>
                    <dd><ul class="adv">
                      {m.advantages.map((a) => (
                        <li><span class={`badge adv-${a.status}`}>{a.status === "tested" ? "Tested" : "Claimed"}</span>
                          <span>{a.text}</span></li>
                      ))}
                    </ul></dd>
                  </>}
                </dl>
                {m.repo &&
                  <div class="meta"><a class="badge public" href={`https://github.com/${m.repo}`}>{m.repo} ↗</a></div>}
                {installBlock(m).lines.length > 0 &&
                  <div class="table-scroll mt-2"><pre class="chip"><code>{installBlock(m).lines.join("\n")}</code></pre></div>}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}

  </section>

  <script>
    // catalogue tools — pure enhancement: JS-off, the page is a complete
    // plain catalogue (accordions open natively; tools stay hidden).
    const tools = document.querySelector("[data-cat-tools]");
    if (tools) {
      tools.hidden = false;
      const accs = [...document.querySelectorAll("[data-acc]")] as HTMLDetailsElement[];
      const count = document.querySelector("[data-filter-count]");
      const input = document.querySelector("[data-filter-input]") as HTMLInputElement;
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const a of accs) {
          const hit = !q || (a.dataset.text ?? "").includes(q);
          if (hit) { a.removeAttribute("data-hide"); shown++; }
          else a.setAttribute("data-hide", "");
          if (q && hit) a.open = true;
        }
        if (count) count.textContent = q ? `${shown} of ${accs.length} shown` : "";
      };
      input.addEventListener("input", apply);
      document.querySelector("[data-expand-all]")?.addEventListener("click",
        () => accs.forEach((a) => { if (!a.hasAttribute("data-hide")) a.open = true; }));
      document.querySelector("[data-collapse-all]")?.addEventListener("click",
        () => accs.forEach((a) => (a.open = false)));
    }
  </script>
</Base>
