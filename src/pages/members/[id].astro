---
import Base from "../../layouts/Base.astro";
import Avatar from "../../components/Avatar.astro";
import { href } from "../../data/site";
import { tiers, installBlock } from "../../data/members";
import { necessityById } from "../../data/necessity";
import { delegateById } from "../../data/delegates";

export function getStaticPaths() {
  return tiers.member.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const member = tiers.member.find((m) => m.id === id)!;
const need = necessityById.get(id!);
const delegate = delegateById.get(id!);
const install = installBlock(member);
const roster = need ? `${need.tier} package` : "package";

const order = tiers.member.map((m) => m.id);
const i = order.indexOf(id!);
const prev = order[(i - 1 + order.length) % order.length];
const next = order[(i + 1) % order.length];

const label = { public: "public", gated: "under development", private: "private",
  disabled: "private · disabled", unspecified: "not public",
  candidate: "candidate", external: "external" };

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: member.id,
  description: member.method,
  programmingLanguage: "R",
  author: { "@type": "Person", name: "Max Moldovan",
    identifier: "https://orcid.org/0000-0001-9680-8474" },
};
---
<Base title={member.id} description={need ? `${member.role} — ${need.question}` : member.role}
      path={`/members/${id}`} jsonLd={jsonLd}>
  <section class="wrap">
    <p class="kicker"><a href={href("/members")}>Packages</a> · {roster}</p>
    <div class="member-hero">
      {delegate && <Avatar motif={delegate.motif}
        label={`${delegate.name}, delegate of ${delegate.people.split(",")[0]}`} />}
      <div>
        <h1>{member.id}</h1>
        <p class="lead mt-1">{member.role}{need && ` — ${need.question}`}</p>
        <div class="meta mt-2">
          {need && <span class="badge">{need.tier}</span>}
          <span class={`badge ${member.visibility}`}>{label[member.visibility]}</span>
          {member.repo &&
            <a class="badge public" href={`https://github.com/${member.repo}`}>{member.repo} ↗</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="grid grid-2">
      <div class="card">
        <p class="kicker">The method</p>
        <p class="prose mt-2">{member.method}</p>
        {member.guard && member.guard !== "none" &&
          <p class="prose muted mt-2"><strong>When it says no:</strong> {member.guard}</p>}
      </div>
      {need && <div class="card">
        <p class="kicker">Why not use the nearest existing tool</p>
        <p class="prose mt-2"><strong>Nearest existing tool:</strong> {need.outside}</p>
        <p class="prose mt-2">{need.why}</p>
        <p class="prose muted mt-2"><em>{need.method}</em></p>
      </div>}
    </div>
  </section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">See it move</p>
      <h2>The idea, animated</h2>
      <p class="prose muted mt-2">An animated sketch of the idea behind the method. It is
        drawn to give an intuition and computes nothing; the evidence is below and in the studies.</p>
    </div>
    <div class="stage">
      <canvas class="widget-canvas" data-widget={id} width="880" height="360"
        role="img" aria-label={`Animated sketch of the ${member.id} method`}></canvas>
      <noscript><p class="prose muted">The sketch needs JavaScript. The method and the
        evidence on this page are complete without it.</p></noscript>
    </div>
  </section>

  <section class="wrap">
    <div class="grid grid-2">
      {need && <div class="card">
        <p class="kicker">Where it has been used and checked</p>
        <p class="prose mt-2">{need.evidence}</p>
      </div>}
      {delegate && <aside class="card delegate-card">
        <p class="kicker">The delegate · a teaching story</p>
        <h3 class="mt-2">{delegate.name} — <span class="muted">{delegate.title}</span></h3>
        <p class="prose mt-2">{delegate.people}</p>
        <p class="prose mt-2"><strong>Frontier:</strong> {delegate.frontier}</p>
        <p class="prose mt-2 creed">“{delegate.creed}”</p>
        <p class="small muted mt-2">The Concord of Long Fields is the site's teaching
          fiction; the science is everything above. <a href={href("/delegates")}>Meet the
          Concord ↗</a></p>
      </aside>}
    </div>
  </section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">Reproduce</p>
      <h2>Install and verify</h2>
    </div>
    {install.lines.length > 0
      ? <div class="table-scroll"><pre class="chip repro-pre"><code>{install.lines.join("\n")}</code></pre></div>
      : <p class="prose mt-2">{member.id}: {install.note}.</p>}
    <p class="prose muted mt-2">Where the package is public, its repository (linked above)
      holds worked examples and tests. The checks that every package declines correctly and
      writes its results in the shared format are described on
      the <a href={href("/governance")}>governance page</a>.</p>
    <div class="cta-row">
      <a class="btn btn-ghost" href={href(`/members/${prev}`)}>← {prev}</a>
      <a class="btn btn-ghost" href={href(`/members/${next}`)}>{next} →</a>
    </div>
  </section>

  <script>
    import { mountWidget } from "../../widgets/registry";
    const c = document.querySelector("[data-widget]") as HTMLCanvasElement | null;
    if (c) mountWidget(c.dataset.widget ?? "", c);
  </script>
</Base>

<style>
  .member-hero { display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; }
  .member-hero .avatar { flex: none; color: var(--paper-ink); }
  .delegate-card { border-style: dashed; }
  .creed { font-family: var(--display); font-size: var(--step-1); }
  .widget-canvas { width: 100%; height: auto; display: block; }
  .repro-pre { padding: 1rem 1.2rem; overflow-x: auto; }
</style>
