---
import Base from "../layouts/Base.astro";
import LoopFigure from "../components/LoopFigure.astro";
import FixtureNote from "../components/FixtureNote.astro";
import OrchestraMap from "../components/OrchestraMap.astro";
import { renderHexRoster, rosterLegend } from "../widgets/hexRosterSvg.mjs";
import { members } from "../data/members";
import { site, href } from "../data/site";
import { examples } from "../data/examples.mjs";
import { withRange } from "../data/format";

const line = (ex: any) => ex.result.refused
  ? `No estimate released: ${ex.result.refusal_reason}`
  : `${ex.result.estimand}: ${withRange(ex.result.estimate, ex.result.lo, ex.result.hi)} ${ex.result.unit} (${ex.result.interval_label})`;
const principles = [
  { h: "A masked copy first", p: "masque makes a masked copy of every dataset, open or confidential. The analyst writes the plan on the copy and never sees the real table." },
  { h: "Tested, then sealed", p: "On the copy, the plan must find an effect planted in the data and must not find one where none was planted. Only then is it sealed, and its fingerprint recorded." },
  { h: "Run where the data are held", p: "conductoR runs the sealed plan on the real data. Each step is done by one package, and each result is checked before the next package uses it." },
  { h: "Little comes back", p: "A failed step returns its name and the kind of error, nothing more. A warning sign the plan was told to look for returns only its name. The result is released once." },
];
const roster = renderHexRoster({ base: href("/") });
const roleOf: Record<string, string> = { ...Object.fromEntries(members.map((m) => [m.id, m.role])), DataHub: "open-data catalogue" };
const jsonLd = {
  "@context": "https://schema.org", "@type": "WebSite",
  name: site.name, description: site.intro,
  author: { "@type": "Person", name: "Max Moldovan", identifier: "https://orcid.org/0000-0001-9680-8474" },
};
---
<Base title="Home" description={site.intro} path="/" jsonLd={jsonLd}>
  <section class="wrap">
    <div class="hero-in">
      <p class="kicker">Crop analytics · {site.counts.members} R packages and a data catalogue</p>
      <h1 class="hero-h1">Crop Analytics Orchestra</h1>
      <p class="lead mt-3">Crop analytics usually joins separate tools by hand, one analysis
        at a time. These {site.counts.members} R packages and an open data catalogue, DataHub, are
        built to work together. Each does one job well on its own, all return results in one shared
        format, and each can decline to answer when the data cannot support an answer.</p>
      <p class="cta-row">
        <a class="btn btn-accent" href={href("/examples")}>See the examples</a>
        <a class="btn btn-ghost" href={href("/members")}>Explore the members</a>
      </p>
    </div>
  </section>

  <section class="band"><div class="wrap">
    <div class="section-head">
      <p class="kicker">The orchestra</p>
      <h2>One package, one job</h2>
      <p class="prose mt-2">Each hexagon is one package, except DataHub, the data catalogue. Its border colour
        shows its role. Choose a hexagon to see the package on the map.</p>
    </div>
    <figure class="hx-figure" set:html={roster} />
    <ul class="hx-legend">
      {rosterLegend.map((g) => (
        <li><span class="hx-dot" style={`--c:${g.color}`}></span><strong>{g.label}.</strong>{" "}
          {g.members.map((id, i) => <>{i ? " · " : ""}<a href={href(`/members/#map-${id}`)} class="mono">{id}</a>{roleOf[id] ? `: ${roleOf[id].charAt(0).toLowerCase()}${roleOf[id].slice(1)}` : ""}</>)}</li>
      ))}
    </ul>
  </div></section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">One study through the orchestra</p>
      <h2>Follow a worked example</h2>
      <p class="prose mt-2">Each button plays one of the four worked examples on open data: the packages light up
        in the order the plan ran them, and the steps and the released result appear beside the map.</p>
    </div>
    <OrchestraMap scenarios />
  </section>

  <section class="band"><div class="wrap">
    <div class="section-head">
      <p class="kicker">How every example runs</p>
      <h2>Five steps, the same each time</h2>
    </div>
    <LoopFigure />
  </div></section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">Examples</p>
      <h2>Worked examples on open data</h2>
    </div>
    <FixtureNote />
    <div class="grid grid-2">
      {examples.map((ex) => (
        <a class="card ex-card" href={href(`/examples/${ex.slug}`)}>
          <p class="kicker">{ex.id} · {ex.data.name}</p>
          <h3>{ex.title}</h3>
          <p class="muted mt-2">{line(ex)}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="band"><div class="wrap">
    <div class="section-head">
      <p class="kicker">Principles</p>
    </div>
    <div class="grid four">
      {principles.map((x) => (
        <div class="card">
          <h3>{x.h}</h3>
          <p class="muted mt-2">{x.p}</p>
        </div>
      ))}
    </div>
  </div></section>
</Base>
