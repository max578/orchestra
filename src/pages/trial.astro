---
import Base from "../layouts/Base.astro";
import { href } from "../data/site";

const stages = [
  { id: "S0 — the shadow season", window: "2026-09 to 2027-02",
    what: "Predictions sealed (hashed and dated) before outcomes exist, never acted on, scored against independently published results: flowering windows for public NVT trial sites, then variety rankings sealed before the season's results are released. A typed refusal is a first-class prediction — sealed, counted, and scored for correctness.",
    counterfactual: "The published district record; a naive carry-over baseline the orchestra must beat before claiming anything." },
  { id: "S1 — paired strips", window: "2027 winter-crop season",
    what: "On partner paddocks: the orchestra's sealed recommendation on one strip, the grower's standard practice on its pair, strip position randomised, harvest split-weighed. Primary endpoint: paired difference in realised profit per hectare at grounded prices; where the orchestra refuses, it recommends standard practice — recorded as the null it is.",
    counterfactual: "The paired strip itself." },
  { id: "S2 — the programme", window: "the AAGI2 horizon",
    what: "The district measurement programme (a fortnightly flowering map with confidence or refusal), the breeding arm with genetic gain per year on the record, and programme-level impact attribution — each with its own locked protocol before its first sealed output.",
    counterfactual: "Stated per protocol at each lock; annual benefit-cost reported with counterfactual, attribution and adoption profile." },
];
---
<Base title="Trial"
      description="Orchestra in Season — a staged, pre-registered real-time trial: every prediction sealed before its outcome exists, every refusal scored, the economics recorded decision by decision."
      path="/trial">
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">Orchestra in Season</p>
      <h1>Sealed before scored</h1>
      <p class="lead mt-3">The synthetic-belt study was the rehearsal. The trial is the
        season itself: the orchestra commits its predictions and decisions in real time,
        each one hashed and dated <em>before</em> the outcome exists, and the economics
        are recorded decision by decision.</p>
    </div>
    <div class="grid grid-3">
      {stages.map((s) => (
        <div class="card">
          <p class="kicker">{s.id}</p>
          <p class="small muted mt-1">{s.window}</p>
          <p class="prose small mt-2">{s.what}</p>
          <p class="prose small muted mt-2"><strong>Counterfactual:</strong> {s.counterfactual}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">The discipline</p>
      <h2>Reporting provisions, in force before the first seal</h2>
    </div>
    <ul class="prose">
      <li>A sealed prediction is scored whatever it shows; unscorable sites are accounted in a flow table, never dropped.</li>
      <li>Refusals are predictions: sealed, counted, and scored for whether refusing was right.</li>
      <li>One primary endpoint per sub-study, stated in the locked analysis plan; everything else is labelled exploratory.</li>
      <li>Null and negative results are reported with the same prominence as positive ones.</li>
      <li>Every reported number resolves to a ledger row or a hashed artefact.</li>
      <li>Partner farm data never leaves its custodian (the sovereign-twin route); public identifiers are opaque; nothing finer than district-level location is ever published.</li>
    </ul>
  </section>

  <section class="wrap">
    <div class="section-head">
      <p class="kicker">The register</p>
      <h2>Locks and seals</h2>
      <p class="prose muted mt-2">The protocol and analysis plan lock (their hashes
        published here) before the first sealed prediction; the scoreboard appears
        only after outcomes are published by their independent sources.</p>
    </div>
    <div class="table-scroll">
      <table>
        <caption>Lock register — nothing is sealed yet.</caption>
        <thead><tr><th scope="col">date</th><th scope="col">what</th><th scope="col">sha256</th></tr></thead>
        <tbody>
          <tr><td colspan="3" class="muted">Stage 0 target lock: 2026-09-20. The full
            protocol and analysis-plan texts are published here at lock.</td></tr>
        </tbody>
      </table>
    </div>
    <p class="prose muted mt-3">Governance — the refusal contract, the conformance
      gates, and the data firewall — is on the
      <a href={href("/governance")}>governance page</a>.</p>
  </section>
</Base>
