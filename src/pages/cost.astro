---
// What a rebuild of the orchestra would cost. Every number is read from the
// cost model files in src/data/cost/ (copied from the value pack, 2026-10-15).
import Base from "../layouts/Base.astro";
import { href } from "../data/site";
import summary from "../data/cost/cost_summary.json";
import modelCsv from "../data/cost/cost_model.csv?raw";
import modelMd from "../data/cost/cost_model.md?raw";
import fleetCsv from "../data/cost/fleet_metrics.csv?raw";

function parseCsv(text: string): Record<string, string>[] {
  const rows: string[][] = [];
  let row: string[] = [], cell = "", q = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (q) { if (c === '"' && text[i + 1] === '"') { cell += '"'; i++; } else if (c === '"') q = false; else cell += c; }
    else if (c === '"') q = true;
    else if (c === ",") { row.push(cell); cell = ""; }
    else if (c === "\n") { row.push(cell); rows.push(row); row = []; cell = ""; }
    else if (c !== "\r") cell += c;
  }
  if (cell || row.length) { row.push(cell); rows.push(row); }
  const [head, ...body] = rows;
  return body.filter((r) => r.length === head.length).map((r) => Object.fromEntries(head.map((h, i) => [h, r[i]])));
}
const items = parseCsv(modelCsv);
const fleet = Object.fromEntries(parseCsv(fleetCsv).map((r) => [r.package, r]));

// Words in the source files that the site words differently.
const reword = (s: string) => s.replace(/manuscript line/g, "line of publication text").replace(/`/g, "")
  .replace("A trial run of study S2 is left out. ", "")
  .replace(/ from the source trees \([^)]*\)/, " from the source code");
const section = (title: string) => {
  const m = modelMd.match(new RegExp(`## ${title}\\n([\\s\\S]*?)(?=\\n## |$)`));
  if (!m) throw new Error(`cost_model.md has no "${title}" section`);
  return m[1];
};
const assumptions = [...section("Assumptions").matchAll(/^\d+\.\s+(.+)$/gm)].map((m) => reword(m[1]));
const sources = section("Sources").split("\n").filter((l) => l.startsWith("| ") && !l.startsWith("| Source"))
  .map((l) => l.split("|").slice(1, -1).map((c) => reword(c.trim())));
if (!assumptions.length || !sources.length) throw new Error("cost_model.md: assumptions or sources not found");
const linkify = (s: string) => s.split(/(https?:\/\/\S+)/);

const S = summary.scenarios as Record<string, any>;
const keys = ["lean", "realistic", "commercial"] as const;
const name = { lean: "Lean team", realistic: "Realistic minimum team", commercial: "Commercial firm" };
const teamLine = (k: string) => { const s = S[k].team.map((m: any) => `${m.role} (${m.fte} full-time)`).join("; "); return s.charAt(0).toUpperCase() + s.slice(1); };
const aud = (x: number, to = 1) => `$${(Math.round(x / to) * to).toLocaleString("en-AU")}`;
const n0 = (x: number) => Math.round(x).toLocaleString("en-AU");
const groups = [
  ["package", "R packages"], ["contract", "Shared result format"], ["data", "DataHub"], ["study", "Studies"],
  ["publication", "Website, posters and publications"], ["governance", "Decision records and audits"], ["overhead", "Coordination, management and contingency"],
] as const;
const sum = (sc: string, pred: (r: Record<string, string>) => boolean) =>
  items.filter((r) => r.scenario === sc && pred(r)).reduce((s, r) => s + Number(r.cost_aud), 0);
const pkgs = Object.entries(summary.complexity_multipliers as Record<string, any>)
  .map(([p, c]) => ({ p, c, cost: Object.fromEntries(keys.map((k) => [k, sum(k, (r) => r.item.startsWith(`${p}:`))])) }))
  .sort((a, b) => b.cost.lean - a.cost.lean);
const lines = (p: string) => (fleet[p] ? Number(fleet[p].r_loc) + Number(fleet[p].src_loc) : NaN);
const devHours = items.filter((r) => r.scenario === "lean" && r.item.endsWith(": development")).reduce((s, r) => s + Number(r.hours), 0);
const fbShare = (k: string) => Math.round((sum(k, (r) => r.item.startsWith("flexyBayes:")) / S[k].total_aud) * 100);
const sens = Object.keys(S.lean.sensitivity);
const sensLabel = (s: string) => ({ mid: "Mid estimate", "rates low": "Rates at the low end", "rates high": "Rates at the high end",
  "all favourable": "All settings favourable", "all unfavourable": "All settings unfavourable" } as Record<string, string>)[s]
  ?? s.charAt(0).toUpperCase() + s.slice(1).replace("-30%", "30% lower").replace("+30%", "30% higher");
const M = summary.method as any;
const rating: Record<string, string> = { N: "nominal", H: "high", VH: "very high", XH: "extra high" };
const nPkg = Object.keys(summary.cocomo_cross_check.per_package_hours).length;
---
<Base title="What it would cost to build" description="An estimate, in Australian dollars, of what it would cost to build the orchestra's software again: three ways of staffing the work, costed with COCOMO II.2000. These are estimates of a rebuild, not money spent." path="/cost">
  <section class="wrap">
    <div class="section-head">
      <p class="kicker">Estimate · {summary.generated}</p>
      <h1>What it would cost to build</h1>
      <p class="prose lead mt-2">Three ways the same software could have been built, each costed in Australian
        dollars. These are estimates of what it would cost to build the software again, not money spent.</p>
    </div>

    <div class="grid grid-3">
      {keys.map((k) => (
        <article class="card">
          <p class="kicker">{name[k]}</p>
          <p class="result-n">{aud(S[k].total_aud, 1000)}</p>
          <p class="small muted mt-1">All-low to all-high settings: {aud(S[k].band_aud.low, 1000)} to {aud(S[k].band_aud.high, 1000)}.
            {" "}{n0(S[k].person_months_cocomo_152h)} person-months ({S[k].person_years_1725h.toFixed(1)} person-years).</p>
          <p class="small mt-2">{teamLine(k)}.</p>
        </article>
      ))}
    </div>
    <p class="prose small muted mt-2">The range under each total sets every uncertain input to its low value, then to
      its high value. It is not a confidence interval. Totals are rounded to the nearest $1,000.</p>

    <h2 class="mt-4">Method</h2>
    <p class="prose">The development effort for each piece of code comes from the {M.model} model (Boehm et al., 2000):
      person-months = {M.a} × (thousands of source lines)<sup>{M.exponent}</sup> × the product of the effort multipliers,
      at {M.hours_per_person_month} hours per person-month. Size counts R lines that are not comments, plus C++ lines.
      Tests and documentation are part of COCOMO's development effort; the measured test volume ({M.evidence.test_lines_per_source_line} test lines per source line,
      {" "}{n0(M.evidence.tests)} tests) and the {M.evidence.vignettes} vignettes set required reliability
      ({M.effort_multipliers.rely_high.toFixed(2)}) and documentation ({M.effort_multipliers.docu_high.toFixed(2)}) to high. Complexity is
      rated package by package. Method design adds
      {" "}{Math.round(M.design_share * 100)}% of each package's effort. Releases, data, study plans and reports,
      posters, publications and decision records are priced from their counts.</p>

    <h2 class="mt-4">Cost by group</h2>
    <div class="table-scroll mt-1" tabindex="0"><table class="num">
      <thead><tr><th scope="col">Group</th>{keys.map((k) => <th scope="col">{name[k]}</th>)}</tr></thead>
      <tbody>
        {groups.map(([g, label]) => (
          <tr><th scope="row">{label}</th>{keys.map((k) => <td>{S[k].subtotals_by_group_aud[g] ? aud(S[k].subtotals_by_group_aud[g], 100) : "none"}</td>)}</tr>
        ))}
        <tr><th scope="row">Total</th>{keys.map((k) => <td><strong>{aud(S[k].total_aud, 1000)}</strong></td>)}</tr>
      </tbody>
    </table></div>

    <h2 class="mt-4">By package</h2>
    <p class="prose">Development, method design and release work for each package. Complexity uses the COCOMO II
      rating: nominal, high, very high or extra high.</p>
    <div class="table-scroll mt-1" tabindex="0"><table class="num">
      <thead><tr><th scope="col">Package</th><th scope="col">Source lines</th><th scope="col">Complexity</th>{keys.map((k) => <th scope="col">{name[k]}</th>)}</tr></thead>
      <tbody>{pkgs.map((x) => (
        <tr><th scope="row">{x.p === "orchestraManifest" ? "orchestraManifest (shared result format)" : x.p}</th>
          <td>{Number.isFinite(lines(x.p)) ? n0(lines(x.p)) : "not measured"}</td><td>{rating[x.c.cplx] ?? x.c.cplx} ({x.c.mult})</td>
          {keys.map((k) => <td>{aud(x.cost[k], 100)}</td>)}</tr>))}</tbody>
    </table></div>
    <ul class="prose small mt-2">{pkgs.filter((x) => x.c.cplx !== "N").map((x) => <li><strong>{x.p}</strong> ({rating[x.c.cplx] ?? x.c.cplx}): {x.c.reason}</li>)}</ul>

    <h2 class="mt-4">Teams</h2>
    {keys.map((k) => (
      <div class="mt-2">
        <h3 class="mt-2">{name[k]}</h3>
        <div class="table-scroll mt-1" tabindex="0"><table class="num">
          <thead><tr><th scope="col">Role</th><th scope="col">Full-time equivalent</th><th scope="col">Hours</th><th scope="col">Rate (AUD/h)</th><th scope="col">Cost</th></tr></thead>
          <tbody>{S[k].team.map((t: any) => <tr><th scope="row">{t.role}</th><td>{t.fte}</td><td>{n0(t.hours)}</td><td>{t.rate_aud_h.toFixed(2)}</td><td>{aud(t.cost_aud, 100)}</td></tr>)}</tbody>
        </table></div>
      </div>
    ))}

    <h2 class="mt-4">Checks on the estimate</h2>
    <ul class="prose">
      <li><strong>Effort.</strong> {S.lean.person_years_1725h.toFixed(1)} person-years for the lean team,
        {" "}{S.realistic.person_years_1725h.toFixed(1)} for the realistic team and {S.commercial.person_years_1725h.toFixed(1)} for
        the commercial firm. The underlying work is the same {n0(S.lean.hours)} hours in each; the realistic team adds review
        and coordination, and the firm adds management, testing, writing, discovery and warranty.</li>
      <li><strong>Cross-check.</strong> COCOMO II with every driver at nominal gives {n0(summary.cocomo_cross_check.hours)}
        {" "}development hours for the {nPkg - 1} packages and the shared result format package, against {n0(devHours)} here. The high reliability, documentation and
        complexity ratings raise the effort, and the skilled-team rating ({M.effort_multipliers.personnel_skilled}) brings it
        back below nominal.</li>
      <li><strong>Cost per source line.</strong> Over {n0(S.lean.lines_counted)} source lines: ${S.lean.cost_per_line_aud.toFixed(2)}
        {" "}(lean), ${S.realistic.cost_per_line_aud.toFixed(2)} (realistic) and ${S.commercial.cost_per_line_aud.toFixed(2)} (commercial).</li>
      <li><strong>Concentration.</strong> flexyBayes is {fbShare("lean")}% of the lean total, {fbShare("realistic")}% of the
        realistic total and {fbShare("commercial")}% of the commercial total.</li>
    </ul>
    <h3 class="mt-3">Sensitivity</h3>
    <div class="table-scroll mt-1" tabindex="0"><table class="num">
      <thead><tr><th scope="col">Case</th>{keys.map((k) => <th scope="col">{name[k]}</th>)}</tr></thead>
      <tbody>{sens.map((s) => <tr><th scope="row">{sensLabel(s)}</th>{keys.map((k) => <td>{aud(S[k].sensitivity[s].total_aud, 1000)}</td>)}</tr>)}</tbody>
    </table></div>

    <h2 class="mt-4">Assumptions</h2>
    <ol class="prose">{assumptions.map((a) => <li>{a}</li>)}</ol>
    <h3 class="mt-3">Figures without a published source</h3>
    <ul class="prose">{(summary.unsourced as any[]).map((u) => <li><strong>{reword(u.item)}.</strong> {reword(u.assumption)}</li>)}</ul>

    <h2 class="mt-4">Sources</h2>
    <ul class="prose refs">{sources.map(([s, used]) => (
      <li>{linkify(s).map((part, k) => (k % 2 ? <a href={part}>{part}</a> : part))} <span class="muted">Used for: {used}.</span></li>))}</ul>

    <p class="cta-row"><a class="btn btn-ghost" href={href("/")}>Home</a></p>
  </section>
</Base>
